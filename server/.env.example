# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replace USER, PASSWORD, CLUSTER)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ascend

# JWT - use a long random string (never commit the real one)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173
